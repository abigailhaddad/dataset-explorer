 "key": "row_key",
 "asOf": {
  "sql": "SELECT CAST(max(date) AS VARCHAR) FROM t",
  "label": "Latest announcement in this table: {value}."
 },
 "covers": "One row per contract award in the Department's daily contract announcements (not one row per day). The award text is as published; dollar amounts and contract numbers are only inside that text.",
 "caveats": [
  "Company and place are a best-effort pattern match on the start of each paragraph. They are left blank when the match is not confident, and they are not scraped facts.",
  "Fewer than ten announcement days (out of about 3,000) are missing because war.gov errors on them or removed them.",
  "The agency header keeps the source's own typos and casing.",
  "U.S. government works are in the public domain. This is not an official Department product."
 ],

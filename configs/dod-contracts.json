{
 "id": "dod-contracts",
 "title": "DoD contracts",
 "blurb": "Daily Defense contract awards from war.gov, 2014 to now.",
 "hfDataset": "abigailhaddad/dod-daily-contracts",
 "source": {
  "format": "parquet",
  "discover": {
   "hfDataset": "abigailhaddad/dod-daily-contracts",
   "path": "data"
  },
  "materialize": true
 },
 "key": "row_key",
 "covers": "One row per award, not per day. Dollar amounts and contract numbers are only in the award text. Public-domain text; not an official Department product.",
 "caveats": [
  "Company and place are pattern matches, left blank when unsure. They are not scraped facts.",
  "A few announcement days are missing where war.gov errors or removed them.",
  "Agency headers keep the source's typos and casing."
 ],
 "links": [
  {
   "label": "Dataset card",
   "href": "https://huggingface.co/datasets/abigailhaddad/dod-daily-contracts"
  },
  {
   "label": "Code",
   "href": "https://github.com/abigailhaddad/dod"
  },
  {
   "label": "Source: war.gov contract announcements",
   "href": "https://www.war.gov/News/Contracts/"
  }
 ],
 "searchColumns": [
  "text",
  "company",
  "place",
  "agency"
 ],
 "defaultSort": {
  "col": "date",
  "dir": "desc"
 },
 "pageSize": 50,
 "detail": {
  "title": "{company}, {date}",
  "links": [
   {
    "label": "Announcement on war.gov",
    "href": "{link}"
   }
  ]
 },
 "columns": [
  {
   "key": "row_key",
   "label": "Row key",
   "type": "text",
   "expr": "link || '#' || CAST(row_index AS VARCHAR)",
   "show": false
  },
  {
   "key": "date",
   "label": "Announced",
   "type": "date",
   "filter": "range"
  },
  {
   "key": "agency",
   "label": "Agency header",
   "type": "text",
   "filter": "select"
  },
  {
   "key": "company",
   "label": "Company",
   "type": "text",
   "filter": "text",
   "help": "Pattern match on the start of the paragraph. Blank when unsure."
  },
  {
   "key": "place",
   "label": "Place",
   "type": "text",
   "filter": "text",
   "help": "Pattern match on the start of the paragraph. Blank when unsure."
  },
  {
   "key": "text",
   "label": "Award text",
   "type": "text"
  },
  {
   "key": "article_title",
   "label": "Announcement",
   "type": "text",
   "link": "{link}"
  },
  {
   "key": "link",
   "label": "Announcement URL",
   "type": "text",
   "show": false
  },
  {
   "key": "row_index",
   "label": "Position in announcement",
   "type": "number",
   "show": false
  },
  {
   "key": "scraped_at",
   "label": "Scraped at",
   "type": "text",
   "show": false
  }
 ],
 "stats": [
  {
   "label": "Awards",
   "expr": "count(*)"
  },
  {
   "label": "Days",
   "expr": "count(DISTINCT date)",
   "hint": "Announcement days."
  },
  {
   "label": "Companies",
   "expr": "count(DISTINCT company)",
   "hint": "Pattern-matched names; spellings can vary."
  },
  {
   "label": "Dates",
   "expr": "strftime(min(date), '%Y-%m') || ' to ' || strftime(max(date), '%Y-%m')"
  }
 ],
 "charts": [
  {
   "type": "month",
   "title": "By month",
   "label": "strftime(date, '%Y-%m')",
   "unit": "awards"
  },
  {
   "type": "top",
   "title": "Top branches",
   "label": "agency",
   "unit": "awards",
   "limit": 10
  }
 ]
}

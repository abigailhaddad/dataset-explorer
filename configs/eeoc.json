{
 "id": "eeoc",
 "title": "EEOC decisions",
 "blurb": "Model-read fields from EEOC appeal decisions, since 2025.",
 "hfDataset": "abigailhaddad/eeoc-appellate-decisions",
 "source": {
  "format": "parquet",
  "urls": [
   "https://huggingface.co/datasets/abigailhaddad/eeoc-appellate-decisions/resolve/main/extracted/decisions.parquet"
  ]
 },
 "key": "sha256",
 "covers": "One row per file EEOC posted from 2025. Older files are in the file listing.",
 "caveats": [
  "Model-read fields. Check the source before relying on any.",
  "Posted month is when EEOC posted the file, not the decision date. Almost nothing was posted from December 2024 to January 2026.",
  "\"Discrimination found\" can predate this decision. No includes \"not reached\"."
 ],
 "links": [
  {
   "label": "Dataset card",
   "href": "https://huggingface.co/datasets/abigailhaddad/eeoc-appellate-decisions"
  },
  {
   "label": "Code",
   "href": "https://github.com/abigailhaddad/eeoc-appellate-decisions"
  },
  {
   "label": "Accuracy by column",
   "href": "https://github.com/abigailhaddad/eeoc-appellate-decisions/blob/main/extraction/accuracy.csv"
  }
 ],
 "searchColumns": [
  "agency",
  "job_title",
  "disability_condition",
  "numbers",
  "file_name"
 ],
 "defaultSort": {
  "col": "decision_date",
  "dir": "desc"
 },
 "pageSize": 50,
 "detail": {
  "title": "{agency}, decided {decision_date}",
  "links": [
   {
    "label": "Open the decision on eeoc.gov",
    "href": "{url}"
   }
  ]
 },
 "columns": [
  {
   "key": "sha256",
   "label": "File hash (SHA-256)",
   "type": "text",
   "show": false,
   "help": "Same hash means an exact copy of the file."
  },
  {
   "key": "decision_date",
   "label": "Decision date",
   "type": "date",
   "filter": "range",
   "help": "Blank when none could be read."
  },
  {
   "key": "agency",
   "label": "Agency",
   "type": "text",
   "filter": "select"
  },
  {
   "key": "appealing_party",
   "label": "Appealing party",
   "type": "text",
   "filter": "select"
  },
  {
   "key": "job_title",
   "label": "Complainant's job title",
   "type": "text"
  },
  {
   "key": "discrimination_found",
   "label": "Discrimination found",
   "type": "bool",
   "filter": "select",
   "help": "A finding exists in the case; it may predate this decision. No includes \"not reached\"."
  },
  {
   "key": "complainant_got_relief",
   "label": "Complainant got relief",
   "type": "bool",
   "filter": "select"
  },
  {
   "key": "file_name",
   "label": "File",
   "type": "text",
   "link": "{url}"
  },
  {
   "key": "numbers",
   "label": "Case number(s) in file name",
   "type": "text",
   "help": "Case numbers in the file name. Many appear in more than one file; use the number printed in the document."
  },
  {
   "key": "url",
   "label": "EEOC URL",
   "type": "text",
   "show": false
  },
  {
   "key": "posted_month",
   "label": "Posted month",
   "type": "text",
   "filter": "select",
   "show": false,
   "help": "When EEOC posted the file, not the decision date."
  },
  {
   "key": "aj_found_discrimination",
   "label": "Administrative judge found discrimination",
   "type": "text",
   "filter": "select",
   "show": false
  },
  {
   "key": "agency_action_on_aj",
   "label": "Agency action on the judge's decision",
   "type": "text",
   "show": false
  },
  {
   "key": "commission_changed_result",
   "label": "Commission changed the result",
   "type": "bool",
   "filter": "select",
   "show": false
  },
  {
   "key": "date_formal_complaint",
   "label": "Date of formal complaint",
   "type": "date",
   "show": false
  },
  {
   "key": "complainant_race_stated",
   "label": "Complainant race (as stated)",
   "type": "text",
   "show": false,
   "help": "As stated in the decision, not verified."
  },
  {
   "key": "complainant_sex_stated",
   "label": "Complainant sex (as stated)",
   "type": "text",
   "show": false,
   "help": "As stated in the decision, not verified."
  },
  {
   "key": "disability_condition",
   "label": "Disability or condition",
   "type": "text",
   "show": false
  },
  {
   "key": "representation",
   "label": "Representation",
   "type": "text",
   "filter": "select",
   "show": false
  },
  {
   "key": "basis_race",
   "label": "Basis: race",
   "type": "bool",
   "filter": "select",
   "show": false
  },
  {
   "key": "basis_sex",
   "label": "Basis: sex",
   "type": "bool",
   "filter": "select",
   "show": false
  },
  {
   "key": "basis_disability",
   "label": "Basis: disability",
   "type": "bool",
   "filter": "select",
   "show": false
  },
  {
   "key": "basis_age",
   "label": "Basis: age",
   "type": "bool",
   "filter": "select",
   "show": false
  },
  {
   "key": "basis_reprisal",
   "label": "Basis: reprisal",
   "type": "bool",
   "filter": "select",
   "show": false
  },
  {
   "key": "issue_performance_appraisal",
   "label": "Issue: performance appraisal",
   "type": "bool",
   "show": false
  },
  {
   "key": "issue_non_selection_or_promotion",
   "label": "Issue: non-selection or promotion",
   "type": "bool",
   "show": false
  },
  {
   "key": "theme_telework",
   "label": "Theme: telework",
   "type": "bool",
   "filter": "select",
   "show": false
  },
  {
   "key": "values_dropped",
   "label": "Values dropped by checks",
   "type": "text",
   "show": false
  },
  {
   "key": "source_warnings",
   "label": "Errors printed in the decision",
   "type": "text",
   "show": false
  },
  {
   "key": "ocr_used",
   "label": "OCR used",
   "type": "bool",
   "show": false
  },
  {
   "key": "model",
   "label": "Model",
   "type": "text",
   "show": false
  },
  {
   "key": "prompt_version",
   "label": "Prompt version",
   "type": "text",
   "show": false
  }
 ],
 "stats": [
  {
   "label": "Decisions",
   "expr": "count(*)"
  },
  {
   "label": "Agencies",
   "expr": "count(DISTINCT agency)"
  },
  {
   "label": "Discrimination found",
   "expr": "count(*) FILTER (WHERE discrimination_found)",
   "hint": "Rows marked \"discrimination found\". Model-read."
  },
  {
   "label": "Posted",
   "expr": "min(posted_month) || ' to ' || max(posted_month)"
  }
 ],
 "charts": [
  {
   "type": "month",
   "title": "By month",
   "label": "posted_month",
   "unit": "decisions"
  },
  {
   "type": "top",
   "title": "Top agencies",
   "label": "agency",
   "unit": "decisions",
   "limit": 10
  }
 ]
}

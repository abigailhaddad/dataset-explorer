{
 "id": "mspb",
 "title": "MSPB decisions",
 "blurb": "Every decision file listed in MSPB's manifests, 1979 to now.",
 "hfDataset": "abigailhaddad/mspb-decisions",
 "source": {
  "format": "parquet",
  "urls": [
   "https://huggingface.co/datasets/abigailhaddad/mspb-decisions/resolve/main/decisions.parquet"
  ]
 },
 "key": "id",
 "covers": "One row per decision file in the manifests MSPB publishes. Metadata only: no outcome, no posted date. Unofficial copy; snapshot of 2026-11-08.",
 "caveats": [
  "The manifests say nothing about who won. Read the PDF.",
  "Dates are the decision's issue date, not when MSPB posted it.",
  "Refreshed daily. New decisions appear after MSPB adds them to its manifests."
 ],
 "links": [
  {
   "label": "Dataset card",
   "href": "https://huggingface.co/datasets/abigailhaddad/mspb-decisions"
  },
  {
   "label": "Code",
   "href": "https://github.com/abigailhaddad/mspb-decisions"
  },
  {
   "label": "MSPB decisions",
   "href": "https://www.mspb.gov/decisions/"
  }
 ],
 "searchColumns": [
  "appellant",
  "agency",
  "docket",
  "file"
 ],
 "defaultSort": {
  "col": "date",
  "dir": "desc"
 },
 "pageSize": 50,
 "columns": [
  {
   "key": "id",
   "label": "Id",
   "type": "text",
   "show": false
  },
  {
   "key": "date",
   "label": "Issued",
   "type": "date",
   "filter": "range"
  },
  {
   "key": "type",
   "label": "Type",
   "type": "text",
   "filter": "select"
  },
  {
   "key": "appellant",
   "label": "Appellant",
   "type": "text",
   "filter": "text",
   "suggest": true
  },
  {
   "key": "agency",
   "label": "Agency",
   "type": "text",
   "filter": "text",
   "suggest": true
  },
  {
   "key": "docket",
   "label": "Docket",
   "type": "text"
  },
  {
   "key": "region",
   "label": "Region",
   "type": "text",
   "filter": "select"
  },
  {
   "key": "case_kind",
   "label": "Case kind",
   "type": "text",
   "filter": "select"
  },
  {
   "key": "case_code",
   "label": "Case code",
   "type": "text",
   "show": false
  },
  {
   "key": "order_kind",
   "label": "Order kind",
   "type": "text",
   "filter": "select"
  },
  {
   "key": "doc_title",
   "label": "Title",
   "type": "text",
   "show": false
  },
  {
   "key": "citation",
   "label": "Citation",
   "type": "text",
   "show": false
  },
  {
   "key": "has_text",
   "label": "Manifest had text",
   "type": "bool",
   "show": false
  },
  {
   "key": "url",
   "label": "PDF",
   "type": "text",
   "show": false
  },
  {
   "key": "file",
   "label": "File",
   "type": "text",
   "show": false
  },
  {
   "key": "manifest",
   "label": "Manifest",
   "type": "text",
   "show": false
  },
  {
   "key": "decision_number",
   "label": "Decision number",
   "type": "text",
   "show": false
  },
  {
   "key": "docnumber",
   "label": "MSPB document number",
   "type": "text",
   "show": false
  }
 ],
 "record": {
  "key": "id",
  "title": "{appellant}",
  "subtitle": "{agency} \u00b7 {date}",
  "sections": [
   {
    "title": "Decision",
    "columns": [
     "date",
     "type",
     "order_kind",
     "doc_title",
     "citation",
     "decision_number"
    ]
   },
   {
    "title": "Case",
    "columns": [
     "docket",
     "region",
     "case_kind",
     "case_code",
     "agency",
     "appellant"
    ]
   },
   {
    "title": "Source",
    "columns": [
     "file",
     "docnumber",
     "has_text",
     "manifest",
     "url"
    ]
   }
  ],
  "text": [],
  "links": [
   {
    "label": "Decision PDF on MSPB's site",
    "href": "{url}"
   }
  ],
  "related": [
   {
    "label": "Same docket",
    "cols": [
     "docket"
    ],
    "title": "{doc_title}",
    "sub": "{date} \u00b7 {type}",
    "limit": 8
   }
  ]
 },
 "views": [
  {
   "id": "table",
   "label": "Decisions",
   "subtitle": "Every decision file in MSPB's manifests.",
   "stats": [
    {
     "label": "Decisions",
     "expr": "count(*)"
    },
    {
     "label": "Precedential",
     "expr": "count(*) FILTER (WHERE type = 'precedential')"
    },
    {
     "label": "Agencies",
     "expr": "count(DISTINCT agency)"
    },
    {
     "label": "Newest",
     "expr": "CAST(max(date) AS VARCHAR)"
    }
   ],
   "charts": [
    {
     "type": "year",
     "title": "Decisions by year",
     "label": "strftime(date, '%Y')",
     "unit": "decisions"
    },
    {
     "type": "top",
     "title": "Top agencies",
     "label": "agency",
     "unit": "decisions",
     "limit": 12
    },
    {
     "type": "top",
     "title": "Case kind",
     "label": "case_kind",
     "unit": "decisions",
     "limit": 12
    }
   ]
  }
 ],
 "pivot": {
  "columns": [
   "type",
   "agency",
   "region",
   "case_kind",
   "order_kind"
  ],
  "default": "agency"
 }
}
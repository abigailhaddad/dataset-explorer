{
 "id": "federal-ja",
 "title": "J&A documents",
 "blurb": "Justifications for skipping competition, posted on SAM.gov since 2025.",
 "hfDataset": "abigailhaddad/federal-ja-documents",
 "source": {
  "format": "parquet",
  "urls": [
   "https://huggingface.co/datasets/abigailhaddad/federal-ja-documents/resolve/main/data/notices.parquet"
  ]
 },
 "key": "notice_id",
 "covers": "One row per SAM.gov notice that is a justification for other than full and open competition. Files, text and the AI-generated tables are in the dataset, not here.",
 "caveats": [
  "About half the rows are Special Notices picked by title.",
  "Award fields come from SAM or a USAspending match. Blank means no match, not \"none\".",
  "Some attachments could not be saved, so a notice's files can be missing."
 ],
 "links": [
  {
   "label": "Dataset card",
   "href": "https://huggingface.co/datasets/abigailhaddad/federal-ja-documents"
  },
  {
   "label": "Code",
   "href": "https://github.com/abigailhaddad/federal-ja-documents"
  }
 ],
 "searchColumns": [
  "title",
  "agency",
  "office",
  "awardee",
  "solicitation_number",
  "award_number",
  "description"
 ],
 "defaultSort": {
  "col": "posted_date",
  "dir": "desc"
 },
 "pageSize": 50,
 "columns": [
  {
   "key": "notice_id",
   "label": "Notice id",
   "type": "text",
   "show": false
  },
  {
   "key": "posted_date",
   "label": "Posted",
   "type": "date",
   "filter": "range"
  },
  {
   "key": "title",
   "label": "Title",
   "type": "text"
  },
  {
   "key": "agency",
   "label": "Agency",
   "type": "text",
   "filter": "select"
  },
  {
   "key": "sub_tier",
   "label": "Sub-tier",
   "type": "text",
   "filter": "text"
  },
  {
   "key": "office",
   "label": "Office",
   "type": "text",
   "filter": "text"
  },
  {
   "key": "awardee",
   "label": "Awardee",
   "type": "text",
   "filter": "text"
  },
  {
   "key": "award_amount",
   "label": "Award amount",
   "type": "number",
   "filter": "range",
   "format": "currency"
  },
  {
   "key": "usaspending_extent_competed",
   "label": "Extent competed (USAspending)",
   "type": "text",
   "filter": "select"
  },
  {
   "key": "type",
   "label": "Notice type",
   "type": "text",
   "filter": "select",
   "show": false
  },
  {
   "key": "collection_reason",
   "label": "Why it is here",
   "format": "code",
   "type": "text",
   "filter": "select",
   "show": false
  },
  {
   "key": "solicitation_number",
   "label": "Solicitation number",
   "type": "text",
   "show": false
  },
  {
   "key": "award_number",
   "label": "Award number",
   "type": "text",
   "show": false
  },
  {
   "key": "award_date",
   "label": "Award date",
   "type": "date",
   "show": false
  },
  {
   "key": "naics_code",
   "label": "NAICS",
   "type": "text",
   "filter": "select",
   "show": false
  },
  {
   "key": "sam_justification_authority",
   "label": "Authority cited (SAM)",
   "type": "text",
   "filter": "select",
   "show": false
  },
  {
   "key": "attachment_count",
   "label": "Attachments listed",
   "type": "number",
   "show": false
  },
  {
   "key": "usaspending_matched",
   "label": "Matched to USAspending",
   "type": "bool",
   "filter": "select",
   "show": false,
   "help": "Blank award fields mean no match, not \"none\"."
  },
  {
   "key": "usaspending_total_obligated",
   "label": "Total obligated (USAspending)",
   "type": "number",
   "show": false,
   "format": "currency"
  },
  {
   "key": "usaspending_recipient_name",
   "label": "Recipient (USAspending)",
   "type": "text",
   "show": false
  },
  {
   "key": "usaspending_permalink",
   "label": "USAspending award page",
   "type": "text",
   "show": false
  },
  {
   "key": "sam_link",
   "label": "SAM.gov link",
   "type": "text",
   "show": false
  },
  {
   "key": "description",
   "label": "Description",
   "type": "text",
   "show": false
  },
  {
   "key": "extract_status",
   "from": "status",
   "label": "Extraction status",
   "format": "code",
   "type": "text",
   "show": false,
   "filter": "select",
   "help": "Whether the experimental extraction ran on this notice. Experimental: model-read from the documents.",
   "join": "x"
  },
  {
   "key": "authority_plain",
   "label": "Authority (plain)",
   "type": "text",
   "show": false,
   "filter": "select",
   "help": "The legal authority cited for not competing, as a plain category. Experimental: model-read from the documents.",
   "join": "x"
  },
  {
   "key": "authority_cited",
   "label": "Authority cited",
   "type": "text",
   "show": false,
   "help": "The authority as the document states it. Experimental: model-read from the documents.",
   "join": "x"
  },
  {
   "key": "estimated_value_usd",
   "label": "Stated value",
   "type": "number",
   "show": false,
   "format": "currency",
   "filter": "range",
   "help": "Value stated in the document. Blank when none, or redacted. Experimental: model-read from the documents.",
   "join": "x"
  },
  {
   "key": "value_redacted",
   "label": "Value redacted",
   "type": "bool",
   "show": false,
   "filter": "select",
   "help": "The document hides its value. Experimental: model-read from the documents.",
   "join": "x"
  },
  {
   "key": "value_basis",
   "label": "Value covers",
   "type": "text",
   "show": false,
   "help": "What the stated value covers. Experimental: model-read from the documents.",
   "join": "x"
  },
  {
   "key": "vendor",
   "label": "Vendor",
   "type": "text",
   "show": false,
   "filter": "text",
   "help": "The proposed contractor named in the document. Experimental: model-read from the documents.",
   "join": "x"
  },
  {
   "key": "period_of_performance",
   "label": "Period of performance",
   "type": "text",
   "show": false,
   "help": "How long the work runs. Experimental: model-read from the documents.",
   "join": "x"
  },
  {
   "key": "summary_model_written",
   "label": "Why not competed",
   "type": "text",
   "show": false,
   "help": "The model's summary. Experimental: model-read from the documents.",
   "join": "x"
  },
  {
   "key": "posted_month",
   "label": "Posted month",
   "type": "text",
   "show": false,
   "expr": "NULLIF(substr(CAST(m.posted_date AS VARCHAR), 1, 7), '')"
  }
 ],
 "joins": [
  {
   "id": "x",
   "on": "notice_id",
   "urls": [
    "https://huggingface.co/datasets/abigailhaddad/federal-ja-documents/resolve/main/analysis/extractions.parquet"
   ]
  }
 ],
 "views": [
  {
   "id": "table",
   "label": "Notices",
   "subtitle": "Justifications for skipping competition, posted on SAM.gov since 2025.",
   "stats": [
    {
     "label": "Notices",
     "expr": "count(*)"
    },
    {
     "label": "Agencies",
     "expr": "count(DISTINCT agency)"
    },
    {
     "label": "Matched",
     "expr": "count(*) FILTER (WHERE usaspending_matched)",
     "hint": "Notices matched to a USAspending award."
    },
    {
     "label": "Posted",
     "expr": "strftime(min(posted_date), '%Y-%m') || ' to ' || strftime(max(posted_date), '%Y-%m')"
    }
   ],
   "charts": [
    {
     "type": "month",
     "title": "By month",
     "label": "strftime(posted_date, '%Y-%m')",
     "unit": "notices"
    },
    {
     "type": "top",
     "title": "Top agencies",
     "label": "agency",
     "unit": "notices",
     "limit": 10
    }
   ]
  },
  {
   "id": "authority",
   "label": "Authority",
   "subtitle": "Why competition was skipped. Model-read.",
   "experimental": true,
   "stats": [
    {
     "label": "Notices",
     "expr": "count(*)"
    },
    {
     "label": "Read",
     "expr": "count(*) FILTER (WHERE extract_status = 'extracted')",
     "hint": "Notices the extraction covers. Others are not shown in the charts."
    },
    {
     "label": "Authority found",
     "expr": "count(authority_plain)"
    }
   ],
   "charts": [
    {
     "type": "top",
     "title": "Authority cited",
     "label": "authority_plain",
     "unit": "notices",
     "limit": 8
    },
    {
     "type": "stack",
     "title": "Authority by agency",
     "x": "agency",
     "series": "authority_plain",
     "kind": "category",
     "limit": 8,
     "seriesLimit": 4,
     "unit": "notices",
     "seriesOrder": [
      "only one responsible source",
      "simplified acquisition: only one source reasonably available",
      "unusual and compelling urgency",
      "exception to fair opportunity: only one source capable"
     ],
     "where": "authority_plain IS NOT NULL",
     "note": "Notices with an authority read."
    }
   ]
  },
  {
   "id": "value",
   "label": "Value",
   "subtitle": "Stated values. Many are redacted.",
   "experimental": true,
   "stats": [
    {
     "label": "Stated",
     "expr": "count(estimated_value_usd)",
     "hint": "Notices with a value read from the document."
    },
    {
     "label": "Redacted",
     "expr": "count(*) FILTER (WHERE value_redacted)"
    },
    {
     "label": "Stated total",
     "expr": "sum(estimated_value_usd)",
     "format": "currency",
     "hint": "Sum of stated values. Excludes redacted and blank."
    }
   ],
   "charts": [
    {
     "type": "items",
     "title": "Value found",
     "unit": "notices",
     "items": [
      {
       "label": "Value stated",
       "expr": "count(estimated_value_usd)"
      },
      {
       "label": "Value redacted",
       "expr": "count(*) FILTER (WHERE value_redacted)"
      },
      {
       "label": "Read, neither",
       "expr": "count(*) FILTER (WHERE extract_status = 'extracted' AND estimated_value_usd IS NULL AND NOT coalesce(value_redacted, false))"
      }
     ]
    },
    {
     "type": "top",
     "title": "Stated value by agency",
     "label": "agency",
     "value": "sum(estimated_value_usd)",
     "format": "currency",
     "unit": "dollars",
     "limit": 10
    }
   ]
  },
  {
   "id": "vendors",
   "label": "Vendors",
   "subtitle": "Proposed contractors named in the notices.",
   "experimental": true,
   "stats": [
    {
     "label": "Named",
     "expr": "count(vendor)"
    },
    {
     "label": "Distinct",
     "expr": "count(DISTINCT vendor)",
     "hint": "Spellings can vary."
    }
   ],
   "charts": [
    {
     "type": "top",
     "title": "Top vendors",
     "label": "vendor",
     "unit": "notices",
     "limit": 15
    },
    {
     "type": "top",
     "title": "Stated value by vendor",
     "label": "vendor",
     "value": "sum(estimated_value_usd)",
     "format": "currency",
     "unit": "dollars",
     "limit": 15
    }
   ]
  },
  {
   "id": "matched",
   "label": "Matched",
   "subtitle": "Notices linked to a USAspending award.",
   "stats": [
    {
     "label": "Matched",
     "expr": "count(*) FILTER (WHERE usaspending_matched)"
    },
    {
     "label": "Share",
     "expr": "round(100.0 * count(*) FILTER (WHERE usaspending_matched) / nullif(count(*), 0), 1) || '%'"
    },
    {
     "label": "Obligated",
     "expr": "sum(usaspending_total_obligated)",
     "format": "currency",
     "hint": "Total obligated on matched awards."
    }
   ],
   "charts": [
    {
     "type": "stack",
     "title": "Matched by month",
     "x": "posted_month",
     "series": "CASE WHEN usaspending_matched THEN 'Matched' ELSE 'Not matched' END",
     "kind": "month",
     "seriesLimit": 2,
     "unit": "notices",
     "seriesOrder": [
      "Matched",
      "Not matched"
     ]
    },
    {
     "type": "top",
     "title": "Matched share by agency",
     "label": "agency",
     "value": "100.0 * count(*) FILTER (WHERE usaspending_matched) / count(*)",
     "format": "percent",
     "unit": "%",
     "min": 50,
     "limit": 10
    }
   ]
  }
 ],
 "pivot": {
  "default": "agency",
  "columns": [
   "agency",
   "type",
   "collection_reason",
   "usaspending_matched",
   "usaspending_extent_competed",
   "naics_code",
   "posted_month",
   "authority_plain",
   "value_redacted"
  ],
  "measures": [
   {
    "id": "stated",
    "label": "Stated value (sum)",
    "expr": "sum(estimated_value_usd)",
    "format": "currency"
   },
   {
    "id": "obligated",
    "label": "Obligated on matched awards (sum)",
    "expr": "sum(usaspending_total_obligated)",
    "format": "currency"
   }
  ]
 },
 "record": {
  "key": "notice_id",
  "title": "{title}",
  "subtitle": "{agency} · {posted_date}",
  "sections": [
   {
    "title": "Notice",
    "columns": [
     "posted_date",
     "type",
     "collection_reason",
     "solicitation_number",
     "naics_code",
     "sam_justification_authority",
     "attachment_count"
    ]
   },
   {
    "title": "Agency",
    "columns": [
     "agency",
     "sub_tier",
     "office"
    ]
   },
   {
    "title": "Award",
    "columns": [
     "awardee",
     "award_amount",
     "award_number",
     "award_date"
    ]
   },
   {
    "title": "USAspending",
    "columns": [
     "usaspending_matched",
     "usaspending_extent_competed",
     "usaspending_total_obligated",
     "usaspending_recipient_name",
     "usaspending_permalink"
    ]
   },
   {
    "title": "Read from the documents (experimental)",
    "columns": [
     "extract_status",
     "authority_plain",
     "authority_cited",
     "estimated_value_usd",
     "value_basis",
     "value_redacted",
     "vendor",
     "period_of_performance"
    ]
   },
   {
    "title": "Identifiers",
    "columns": [
     "notice_id",
     "sam_link"
    ]
   }
  ],
  "text": [
   {
    "label": "Description",
    "column": "description"
   },
   {
    "label": "Why not competed (model-written, experimental)",
    "column": "summary_model_written"
   }
  ],
  "links": [
   {
    "label": "Notice on SAM.gov",
    "href": "{sam_link}"
   },
   {
    "label": "Saved files on Hugging Face",
    "href": "https://huggingface.co/datasets/abigailhaddad/federal-ja-documents/tree/main/files/{notice_id:enc}",
    "showIf": {
     "col": "attachment_count",
     "min": 1
    }
   },
   {
    "label": "Award on USAspending",
    "href": "{usaspending_permalink}"
   }
  ],
  "more": [
   {
    "id": "attachments",
    "label": "Attachments",
    "button": "Load attachments",
    "hint": "Reads a 100 MB table. Takes several seconds.",
    "url": "https://huggingface.co/datasets/abigailhaddad/federal-ja-documents/resolve/main/data/attachments.parquet",
    "where": "notice_id",
    "value": "notice_id",
    "columns": [
     {
      "key": "filename",
      "label": "File"
     },
     {
      "key": "file_kind",
      "label": "Kind"
     },
     {
      "key": "page_count",
      "label": "Pages"
     },
     {
      "key": "text_source",
      "label": "Text from"
     },
     {
      "key": "download_status",
      "label": "Download"
     },
     {
      "key": "access_status",
      "label": "Access"
     }
    ],
    "text": "text"
   }
  ],
  "related": [
   {
    "label": "Same award number",
    "cols": [
     "award_number"
    ],
    "title": "{title}",
    "sub": "{agency} · {posted_date}",
    "limit": 8
   },
   {
    "label": "Same solicitation",
    "cols": [
     "solicitation_number"
    ],
    "title": "{title}",
    "sub": "{agency} · {posted_date}",
    "limit": 8
   },
   {
    "label": "Same vendor",
    "cols": [
     "vendor"
    ],
    "title": "{title}",
    "sub": "{agency} · {posted_date}",
    "limit": 8
   }
  ]
 }
}

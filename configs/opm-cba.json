{
 "id": "opm-cba",
 "title": "OPM union contracts",
 "blurb": "Federal union contracts from OPM, with termination flags.",
 "hfDataset": "abigailhaddad/opm-cba-agreements",
 "source": {
  "format": "csv",
  "urls": [
   "https://huggingface.co/datasets/abigailhaddad/opm-cba-agreements/resolve/main/agreements.csv"
  ]
 },
 "key": "id",
 "covers": "One row per agreement in OPM's database, with the PDF and its text on Hugging Face. Unofficial copy.",
 "caveats": [
  "Termination flags are leads, not findings. \"Inferred\" means the agency ended all its agreements in a category.",
  "Court status goes stale. Check a flag before relying on it.",
  "The weekly job checks OPM's listing only. Files, text and flags are rebuilt by hand."
 ],
 "links": [
  {
   "label": "Dataset card",
   "href": "https://huggingface.co/datasets/abigailhaddad/opm-cba-agreements"
  },
  {
   "label": "Code and methods",
   "href": "https://github.com/abigailhaddad/opm-cba-archive"
  },
  {
   "label": "OPM's database",
   "href": "https://www.opm.gov/policy-data-oversight/labor-management-relations/collective-bargaining-agreements/"
  }
 ],
 "searchColumns": [
  "agencyName",
  "subAgencyOrComponent",
  "laborUnionName",
  "fileName",
  "activityOfficeRegion"
 ],
 "defaultSort": {
  "col": "agencyName",
  "dir": "asc"
 },
 "pageSize": 50,
 "detail": {
  "title": "{agencyName}: {laborUnionName}",
  "links": [
   {
    "label": "PDF on Hugging Face",
    "href": "https://huggingface.co/datasets/abigailhaddad/opm-cba-agreements/resolve/main/pdfs/{id:enc}.pdf",
    "showIf": {
     "col": "download_status",
     "equals": "ok"
    }
   },
   {
    "label": "Extracted text",
    "href": "https://huggingface.co/datasets/abigailhaddad/opm-cba-agreements/resolve/main/text/{id:enc}.txt",
    "showIf": {
     "col": "download_status",
     "equals": "ok"
    }
   },
   {
    "label": "File on OPM's site",
    "href": "{fileUrl}"
   }
  ]
 },
 "columns": [
  {
   "key": "id",
   "label": "OPM record id",
   "type": "text",
   "show": false
  },
  {
   "key": "agencyName",
   "label": "Agency",
   "type": "text",
   "filter": "select"
  },
  {
   "key": "subAgencyOrComponent",
   "label": "Sub-agency or component",
   "type": "text",
   "filter": "text"
  },
  {
   "key": "laborUnionName",
   "label": "Union",
   "type": "text",
   "filter": "select"
  },
  {
   "key": "local",
   "label": "Local",
   "type": "text"
  },
  {
   "key": "expirationDate",
   "label": "Expires",
   "type": "date",
   "filter": "range"
  },
  {
   "key": "termination_flag",
   "label": "Termination flag",
   "type": "text",
   "filter": "select",
   "help": "Leads, not findings. \"inferred\": the agency ended all agreements in a category and the order itself could not be downloaded. OPM's own monthly status list is not public."
  },
  {
   "key": "pages",
   "label": "Pages",
   "type": "number",
   "filter": "range"
  },
  {
   "key": "fileName",
   "label": "File on OPM's site",
   "type": "text",
   "link": "{fileUrl}"
  },
  {
   "key": "activityOfficeRegion",
   "label": "Activity, office or region",
   "type": "text",
   "show": false
  },
  {
   "key": "busCodes",
   "label": "Bargaining unit codes",
   "type": "text",
   "show": false
  },
  {
   "key": "listed_fileSize",
   "label": "Listed file size",
   "type": "text",
   "show": false
  },
  {
   "key": "fileUrl",
   "label": "OPM file URL",
   "type": "text",
   "show": false
  },
  {
   "key": "download_status",
   "label": "Download status",
   "type": "text",
   "filter": "select",
   "show": false,
   "help": "A few listed files could not be downloaded. Some records share one file."
  },
  {
   "key": "download_http",
   "label": "Download HTTP status",
   "type": "number",
   "show": false
  },
  {
   "key": "bytes",
   "label": "Bytes",
   "type": "number",
   "show": false
  },
  {
   "key": "sha256",
   "label": "File hash (SHA-256)",
   "type": "text",
   "show": false
  },
  {
   "key": "sha256_dup_count",
   "label": "Records sharing this file",
   "type": "number",
   "show": false
  },
  {
   "key": "duplicate_of",
   "label": "Duplicate of",
   "type": "text",
   "show": false
  },
  {
   "key": "is_pdf_magic",
   "label": "Is a real PDF",
   "type": "bool",
   "show": false
  },
  {
   "key": "words",
   "label": "Words",
   "type": "number",
   "show": false
  },
  {
   "key": "encrypted",
   "label": "Encrypted",
   "type": "bool",
   "show": false
  },
  {
   "key": "text_status",
   "label": "Text status",
   "type": "text",
   "filter": "select",
   "show": false,
   "help": "Scanned agreements have little or no text. No OCR was run."
  },
  {
   "key": "eo_coverage",
   "label": "Executive order coverage",
   "type": "text",
   "filter": "select",
   "show": false
  },
  {
   "key": "eo_section",
   "label": "Executive order section",
   "type": "text",
   "show": false
  },
  {
   "key": "eo_note",
   "label": "Executive order note",
   "type": "text",
   "show": false
  },
  {
   "key": "psf_indicator",
   "label": "Police, fire or security unit",
   "type": "text",
   "filter": "select",
   "show": false
  },
  {
   "key": "termination_basis",
   "label": "Termination basis",
   "type": "text",
   "show": false
  },
  {
   "key": "termination_sources",
   "label": "Termination sources",
   "type": "text",
   "show": false
  }
 ],
 "stats": [
  {
   "label": "Agreements",
   "expr": "count(*)"
  },
  {
   "label": "Agencies",
   "expr": "count(DISTINCT agencyName)"
  },
  {
   "label": "Unions",
   "expr": "count(DISTINCT laborUnionName)"
  },
  {
   "label": "Pages",
   "expr": "sum(pages)"
  }
 ],
 "charts": [
  {
   "type": "top",
   "title": "Top agencies",
   "label": "agencyName",
   "unit": "agreements",
   "limit": 12
  },
  {
   "type": "top",
   "title": "Termination flag",
   "label": "termination_flag",
   "unit": "agreements",
   "limit": 12
  },
  {
   "type": "year",
   "title": "Expiring",
   "label": "strftime(expirationDate, '%Y')",
   "unit": "agreements"
  }
 ]
}

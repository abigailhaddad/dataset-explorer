{
 "id": "oira",
 "title": "OIRA EO 12866 meetings",
 "blurb": "Meetings OIRA held on rules under review, with who asked and who attended.",
 "hfDataset": "abigailhaddad/oira-eo12866-meetings",
 "source": {
  "format": "parquet",
  "urls": [
   "https://huggingface.co/datasets/abigailhaddad/oira-eo12866-meetings/resolve/main/data/meetings.parquet"
  ]
 },
 "key": "meeting_id",
 "covers": "One row per meeting on reginfo.gov, 2025-01-20 to 2026-11-08, with handouts and attendees on Hugging Face. Unofficial copy; read the evening of 2026-11-08.",
 "caveats": [
  "Meetings can be rescheduled and handouts added after this was read.",
  "Attendee and handout counts are blank for meetings not held yet. For held meetings, 0 handouts means the page lists none.",
  "A meeting that reginfo's own search never returns can't be caught by these checks."
 ],
 "links": [
  {
   "label": "Dataset card",
   "href": "https://huggingface.co/datasets/abigailhaddad/oira-eo12866-meetings"
  },
  {
   "label": "Code and checks",
   "href": "https://github.com/abigailhaddad/oira-meetings"
  },
  {
   "label": "reginfo.gov EO 12866 meetings",
   "href": "https://www.reginfo.gov/public/do/eoMeetingSearch"
  }
 ],
 "searchColumns": [
  "rule_title",
  "agency",
  "requestor",
  "requestor_name",
  "rin",
  "requestor_client"
 ],
 "defaultSort": {
  "col": "date",
  "dir": "desc"
 },
 "pageSize": 50,
 "columns": [
  {
   "key": "meeting_id",
   "label": "Meeting id",
   "type": "text",
   "show": false
  },
  {
   "key": "date",
   "label": "Date",
   "type": "date",
   "filter": "range",
   "expr": "TRY_CAST(strptime(meeting_datetime, '%m/%d/%Y %I:%M %p') AS DATE)"
  },
  {
   "key": "agency",
   "label": "Agency",
   "type": "text",
   "filter": "text",
   "suggest": true
  },
  {
   "key": "rin",
   "label": "RIN",
   "type": "text"
  },
  {
   "key": "rule_title",
   "label": "Rule",
   "type": "text"
  },
  {
   "key": "stage",
   "label": "Stage",
   "type": "text",
   "filter": "select"
  },
  {
   "key": "meeting_type",
   "label": "Status",
   "type": "text",
   "filter": "select",
   "help": "Completed = held. Scheduled = not held yet (no attendees or handouts yet). No Show = scheduled but nobody came."
  },
  {
   "key": "attendees",
   "label": "Attendees",
   "type": "number",
   "filter": "range",
   "expr": "CASE WHEN meeting_type = 'Completed' THEN TRY_CAST(n_attendees AS DOUBLE) END",
   "help": "Blank when the meeting has not been held (Scheduled) or nobody came (No Show)."
  },
  {
   "key": "handouts",
   "label": "Handouts",
   "type": "number",
   "filter": "range",
   "expr": "CASE WHEN meeting_type = 'Completed' THEN TRY_CAST(n_documents AS DOUBLE) END",
   "help": "Blank when the meeting has not been held. Zero means held, with no handout on the page."
  },
  {
   "key": "requestor",
   "label": "Requestor",
   "type": "text",
   "filter": "text",
   "suggest": true
  },
  {
   "key": "requestor_name",
   "label": "Requestor name",
   "type": "text",
   "show": false
  },
  {
   "key": "requestor_client",
   "label": "Requestor's client",
   "type": "text",
   "show": false
  },
  {
   "key": "n_attendees",
   "label": "Attendees (raw)",
   "type": "number",
   "filter": "range",
   "show": false
  },
  {
   "key": "n_documents",
   "label": "Handouts (raw)",
   "type": "number",
   "filter": "range",
   "show": false
  },
  {
   "key": "meeting_datetime",
   "label": "Meeting date and time",
   "type": "text",
   "show": false
  },
  {
   "key": "month",
   "label": "Month",
   "type": "text",
   "show": false
  },
  {
   "key": "url",
   "label": "reginfo page",
   "type": "text",
   "show": false
  }
 ],
 "views": [
  {
   "id": "table",
   "label": "Meetings",
   "subtitle": "Every EO 12866 meeting in the archive.",
   "stats": [
    {
     "label": "Meetings",
     "expr": "count(*)"
    },
    {
     "label": "Held",
     "expr": "count(*) FILTER (WHERE meeting_type = 'Completed')"
    },
    {
     "label": "Not held yet",
     "expr": "count(*) FILTER (WHERE meeting_type = 'Scheduled')",
     "hint": "Scheduled on reginfo.gov but not held when this was read."
    },
    {
     "label": "No show",
     "expr": "count(*) FILTER (WHERE meeting_type = 'No Show')"
    },
    {
     "label": "Handouts",
     "expr": "sum(TRY_CAST(n_documents AS DOUBLE))"
    }
   ],
   "charts": [
    {
     "type": "year",
     "title": "Meetings by year",
     "label": "strftime(date, '%Y')",
     "unit": "meetings"
    },
    {
     "type": "top",
     "title": "Status",
     "label": "meeting_type",
     "unit": "meetings",
     "limit": 5
    },
    {
     "type": "top",
     "title": "Agencies",
     "label": "agency",
     "unit": "meetings",
     "limit": 12
    },
    {
     "type": "top",
     "title": "Requestors",
     "label": "requestor",
     "unit": "meetings",
     "limit": 12
    }
   ]
  }
 ],
 "pivot": {
  "columns": [
   "agency",
   "stage",
   "meeting_type",
   "requestor",
   "month"
  ],
  "default": "agency"
 },
 "record": {
  "key": "meeting_id",
  "title": "{rule_title}",
  "subtitle": "{agency} \u00b7 {meeting_datetime}",
  "sections": [
   {
    "title": "Meeting",
    "columns": [
     "meeting_datetime",
     "meeting_type",
     "attendees",
     "handouts",
     "stage"
    ]
   },
   {
    "title": "Rule",
    "columns": [
     "agency",
     "rin",
     "rule_title"
    ]
   },
   {
    "title": "Requested by",
    "columns": [
     "requestor",
     "requestor_name",
     "requestor_client"
    ]
   }
  ],
  "text": [],
  "links": [
   {
    "label": "Meeting page on reginfo.gov",
    "href": "{url}"
   }
  ],
  "related": [
   {
    "label": "Same rule",
    "cols": [
     "rin"
    ],
    "title": "{requestor}",
    "sub": "{meeting_datetime}",
    "limit": 8
   }
  ]
 }
}